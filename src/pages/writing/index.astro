---
import BaseListing from "../../layouts/BaseListing.astro";
import { PAGES } from "../../config";
import { withBase } from "../../utils/paths";

if (PAGES.writing.isActive === false) {
    return Astro.redirect(withBase("404"));
}
---

<BaseListing
    collection="writing"
    title={PAGES.writing.title}
    subtitle={PAGES.writing.subtitle}
/>
