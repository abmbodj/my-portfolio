---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllTags } from "../../utils/tags";
import Tag from "../../components/ui/Tag.astro";
import ContentHeader from "../../components/content/ContentHeader.astro";

const tags = await getAllTags();

const maxCount = Math.max(...tags.map((t) => t.count));
const minCount = Math.min(...tags.map((t) => t.count));

function getTagSize(count: number): "sm" | "md" | "lg" {
    if (tags.length < 5) return "md";
    const range = maxCount - minCount;
    if (range === 0) return "md";

    const normalized = (count - minCount) / range;
    if (normalized > 0.7) return "lg";
    if (normalized > 0.3) return "md";
    return "sm";
}
---

<BaseLayout title="Tags">
    <div class="content-container">
        <ContentHeader
            title="Tags"
            meta={[{ value: `${tags.length} unique topics` }]}
        />

        <div class="container-narrow pt-12">
            {tags.length > 0 ? (
                <div class="tag-cloud flex flex-wrap gap-4 items-center justify-center min-h-[300px]">
                    {tags.map((tag) => (
                        <Tag name={tag.name} count={tag.count} size={getTagSize(tag.count)} />
                    ))}
                </div>
            ) : (
                <section class="empty-state" data-empty-state="tags">
                    <h2>No topics yet</h2>
                    <p>Tags will appear here after you add projects or writing.</p>
                </section>
            )}
        </div>
    </div>
</BaseLayout>
