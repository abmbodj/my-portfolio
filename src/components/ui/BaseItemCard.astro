---
import Tag from "./Tag.astro";
import Icon from "./Icon.astro";
import type { DisplayLink } from "../../types";

interface Props {
    title: string;
    href: string;
    description?: string;
    date?: string;
    tags?: string[];
    links?: DisplayLink[];
}

const { title, href, description, date, tags, links = [] } = Astro.props;
---

<article class="card">
    <div class="card-content">
        <a href={href} class="card-title">{title}</a>

        <div class="card-meta">
            {date && (
                <span class="flex items-center gap-1">
                    <Icon name="Calendar" size={24} />
                    <span>{date}</span>
                </span>
            )}
        </div>

        {
            tags && tags.length > 0 && (
                <div class="flex gap-2 flex-wrap mb-3">
                    {tags.map((tag) => (
                        <Tag name={tag} size="sm" />
                    ))}
                </div>
            )
        }

        {description && <p class="card-desc">{description}</p>}
    </div>

    {links.length > 0 && (
        <div class="card-actions">
            {links.map((link) => (
                <a
                    href={link.href}
                    target={link.external !== false ? "_blank" : undefined}
                    rel={link.external !== false ? "noopener noreferrer" : undefined}
                    class="card-link"
                >
                    {link.label}
                </a>
            ))}
        </div>
    )}
</article>
