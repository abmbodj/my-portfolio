---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BaseItemCard from "../components/ui/BaseItemCard.astro";
import { getListingItem } from "../utils/adapters";
import { withBase } from "../utils/paths";

interface Props {
    collection: "projects" | "writing" | "all";
    title: string;
    subtitle?: string;
    entries?: any[];
    page?: any;
}

const { collection, title, subtitle, entries: manualEntries, page } = Astro.props;

let entries = manualEntries || (collection !== "all"
    ? await getCollection(collection as "projects" | "writing", ({ data }) => data.draft !== true)
    : []);
if (page) entries = page.data;

const sortedEntries = entries.sort((a: any, b: any) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
});

const emptyCopy = {
    projects: {
        title: "Projects coming soon",
        description: "Add project files when you are ready to share selected work.",
    },
    writing: {
        title: "Writing coming soon",
        description: "Add writing files when you are ready to publish technical notes.",
    },
};
---

<BaseLayout title={title}>
    {(title || subtitle) && (
        <header class="page-header">
            {title && <h1 class="page-title">{title}</h1>}
            {subtitle && <p class="page-subtitle">{subtitle}</p>}
        </header>
    )}

    {sortedEntries.length > 0 ? (
        <section class="item-list">
            {sortedEntries.map((entry: any) => {
            const item = getListingItem(entry);
            return <BaseItemCard {...item} href={withBase(`${collection}/${entry.id}`)} />;
            })}
        </section>
    ) : collection !== "all" ? (
        <section class="empty-state" data-empty-state={collection}>
            <h2>{emptyCopy[collection].title}</h2>
            <p>{emptyCopy[collection].description}</p>
        </section>
    ) : null}

    {page && page.lastPage > 1 && (
        <nav class="pagination">
            {page.url.prev ? (
                <a href={page.url.prev} class="pagination-link">Newer</a>
            ) : (
                <span class="pagination-inactive">Newer</span>
            )}
            <span class="pagination-info">Page {page.currentPage} of {page.lastPage}</span>
            {page.url.next ? (
                <a href={page.url.next} class="pagination-link">Older</a>
            ) : (
                <span class="pagination-inactive">Older</span>
            )}
        </nav>
    )}
</BaseLayout>
